# --- Vercel (server-side) ---------------------------------------------------
# Your TypeSafe key. Never ships in the extension.
TYPESAFE_API_KEY=

# Any random string. The extension sends it on every request so the endpoint
# isn't wide open. It ships inside the extension bundle, so treat it as
# obfuscation rather than authentication.
JEV_SHARED_SECRET=

# --- Extension (baked in at build time by WXT) ------------------------------
WXT_CLASSIFY_URL=https://your-deployment.vercel.app/api/classify
WXT_JEV_SHARED_SECRET=
